# ====================================================================
# AI Resume & Job Application Bot — environment configuration
# Copy to `.env` and fill in. Never commit the real .env file.
# ====================================================================

# --- Telegram ---
# Get a token from @BotFather: https://core.telegram.org/bots#botfather
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-here

# --- Anthropic (Claude) ---
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Default to the most capable model. For cost-sensitive scale, the PRD's
# documented alternative is claude-sonnet-4-6 (cheaper, still strong).
ANTHROPIC_MODEL=claude-opus-4-8
# Effort vs cost/latency: low | medium | high | max
ANTHROPIC_EFFORT=medium

# --- Database ---
# Local dev (default): SQLite. Production: a Postgres URL, e.g.
# postgresql+asyncpg://user:pass@host:5432/profolio
DATABASE_URL=sqlite+aiosqlite:///./profolio.db

# --- Quota / pricing ---
FREE_REWRITES=3

# --- Payments: Razorpay ---
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret configured for the webhook in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=
# Public base URL where this app's webhook server is reachable (https).
# Razorpay will POST payment confirmations to <BASE_URL>/razorpay/webhook
PUBLIC_BASE_URL=https://your-app.example.com

# --- Payments: Telegram Stars (XTR) ---
# Telegram Stars need no provider token. Set to "true" to offer Stars checkout.
ENABLE_TELEGRAM_STARS=true

# --- Webhook server ---
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# --- Privacy ---
# Salt used to pseudonymize (hash) Telegram user IDs in the DB (§7.3).
USER_ID_HASH_SALT=change-me-to-a-long-random-string
# Hours after which uploaded resume files are deleted from disk (§7.3).
FILE_RETENTION_HOURS=24

# --- Misc ---
# Directory for temporary uploaded/generated files
DATA_DIR=./data
LOG_LEVEL=INFO
